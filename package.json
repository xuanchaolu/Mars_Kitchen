{
  "name": "mars-kitchen",
  "productName": "火星小厨房",
  "version": "5.0.0",
  "description": "火星小厨房 AI 对话客户端 — Skill.md + A.md/shtu 双人设 + 档位映射的 DeepSeek Agent（联网搜索 + 3D 虚拟形象 + Edge 神经语音播报）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "python3 tools/gen-icon.py",
    "build": "bash build.sh",
    "avatar": "esbuild src/avatar-src.js --bundle --format=iife --target=chrome120 --minify --outfile=renderer/js/avatar.bundle.js",
    "test": "node tools/mars-test.js",
    "test:e2e": "node tools/mars-e2e.js",
    "test:all": "node tools/mars-test.js && node tools/mars-e2e.js"
  },
  "devDependencies": {
    "@pixiv/three-vrm": "^3.0.0",
    "electron": "^33.4.0",
    "electron-packager": "^17.1.2",
    "esbuild": "^0.28.2",
    "three": "^0.160.0"
  },
  "dependencies": {}
}
